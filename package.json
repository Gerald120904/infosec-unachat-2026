{
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.300.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.300.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@sentry/node": "10.78.0",
    "express": "4.22.3",
    "pino": "^10.4.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "artillery": "^2.0.34",
    "chai": "^4.5.0",
    "jest": "^30.5.2",
    "mocha": "^10.2.0",
    "socket.io-client": "^4.8.4"
  },
  "overrides": {
    "proxy-addr": "2.0.8"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.js",
    "test": "mocha --ui bdd",
    "test:integration": "jest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:load:socketio": "artillery run artillery.socketio.yml",
    "test:load:http": "artillery run artillery.http.yml"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/integration/**/*.test.js"
    ]
  }
}
